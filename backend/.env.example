# ============================================================
# Faculty Research Publication Monitoring System — Environment
# ============================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ============================================================

# --- Application ---
APP_NAME="Faculty Research Publication Monitoring System"
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# --- Backend Server ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=research_monitoring
POSTGRES_USER=research_admin
POSTGRES_PASSWORD=changeme_in_production
# DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
DATABASE_URL=

# --- Redis (Celery broker) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/0
CELERY_BROKER_URL=redis://${REDIS_HOST}:${REDIS_PORT}/0
CELERY_RESULT_BACKEND=redis://${REDIS_HOST}:${REDIS_PORT}/1

# --- JWT Authentication ---
JWT_SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_64_CHAR_STRING
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- LLM Provider (Groq) ---
GROQ_API_KEY=
OPENALEX_API_KEY=
# Crossref — no API key required; email enables polite pool
OPENALEX_EMAIL=241FA04931@vignan.ac.in
CROSSREF_EMAIL=241FA04931@vignan.ac.in
# Semantic Scholar — optional
SEMANTIC_SCHOLAR_API_KEY=

# ORCID — optional, later
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=

# Scopus — institutional/API access, later
SCOPUS_API_KEY=
SCOPUS_INST_TOKEN=


# Web of Science (requires institutional subscription)
WOS_API_KEY=

# --- Sync Schedule (cron expressions) ---
SYNC_FULL_DISCOVERY=0 2 * * 0
SYNC_CITATION_REFRESH=0 3 * * 3
SYNC_METRICS_COMPUTE=0 4 * * 3
SYNC_ALERT_GENERATION=0 5 * * *
SYNC_REPORT_GENERATION=0 6 1 * *

# --- Institution ---
INSTITUTION_NAME=Vignan's Foundation for Science, Technology & Research
INSTITUTION_SHORT=VFSTR